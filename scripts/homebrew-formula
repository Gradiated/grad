#!/usr/bin/env python3
"""Print Formula/grad.rb for Gradiated/homebrew-tap from a release's CLI archive checksums.

    scripts/homebrew-formula 0.3.0 DIR > Formula/grad.rb

DIR holds the release workflow's grad-<target>.tar.gz.sha256 files (`shasum -a 256` output),
one per target below. The release workflow runs this after the GitHub Release exists.
"""

import pathlib
import re
import sys

REPO = "https://github.com/Gradiated/grad"
# (Homebrew OS block, CPU block, Rust target), in the formula's order.
TARGETS = [
    ("on_macos", "on_arm", "aarch64-apple-darwin"),
    ("on_macos", "on_intel", "x86_64-apple-darwin"),
    ("on_linux", "on_arm", "aarch64-unknown-linux-musl"),
    ("on_linux", "on_intel", "x86_64-unknown-linux-musl"),
]
SEMVER = r"\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?"


def checksum(directory: pathlib.Path, target: str) -> str:
    name = f"grad-{target}.tar.gz"
    path = directory / f"{name}.sha256"
    if not path.is_file():
        sys.exit(f"homebrew-formula: {path} is missing")
    fields = path.read_text().split()
    if len(fields) != 2 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]) or fields[1].lstrip("*") != name:
        sys.exit(f"homebrew-formula: {path} is not a `shasum -a 256` line for {name}")
    return fields[0]


def formula(version: str, directory: pathlib.Path) -> str:
    lines = [
        "# Updated by the release workflow in Gradiated/grad. Edit there, not here.",
        "class Grad < Formula",
        '  desc "CLI for grad: train, evaluate and ship small task-specific models"',
        f'  homepage "{REPO}"',
        f'  version "{version}"',
        '  license "MIT"',
    ]
    for os_block in ("on_macos", "on_linux"):
        lines += ["", f"  {os_block} do"]
        for block, cpu, target in TARGETS:
            if block != os_block:
                continue
            lines += [
                f"    {cpu} do",
                f'      url "{REPO}/releases/download/v{version}/grad-{target}.tar.gz"',
                f'      sha256 "{checksum(directory, target)}"',
                "    end",
            ]
        lines.append("  end")
    lines += [
        "",
        "  def install",
        '    bin.install "grad"',
        "  end",
        "",
        "  test do",
        '    assert_match version.to_s, shell_output("#{bin}/grad --version")',
        "  end",
        "end",
    ]
    return "\n".join(lines) + "\n"


def main(args: list[str]) -> None:
    if len(args) != 2 or not re.fullmatch(SEMVER, args[0]):
        sys.exit(__doc__)
    sys.stdout.write(formula(args[0], pathlib.Path(args[1])))


if __name__ == "__main__":
    main(sys.argv[1:])
