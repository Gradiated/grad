{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gradiated/grad/blob/main/spec/artifacts/decision_bundle.schema.json",
  "title": "decision_bundle decision_config.json",
  "description": "Decision model runtime config: questions (one head each), head layout and calibration.",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "questions",
    "temperatures",
    "calibrated",
    "head_file",
    "adapter",
    "pooling",
    "hidden_size",
    "max_seq_len",
    "chat_template_kwargs",
    "truncation_side",
    "template_revision",
    "base_model",
    "base_model_repo",
    "base_model_revision"
  ],
  "properties": {
    "format": {
      "const": "decision_bundle"
    },
    "format_version": {
      "enum": [
        1,
        2
      ]
    },
    "questions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[^.]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "options"
        ],
        "properties": {
          "type": {
            "enum": [
              "choice",
              "noul",
              "score"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "noul"
                }
              }
            },
            "then": {
              "properties": {
                "options": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "options": {
                  "minItems": 2,
                  "uniqueItems": true
                }
              }
            }
          }
        ]
      }
    },
    "temperatures": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "calibrated": {
      "type": "boolean"
    },
    "head_file": {
      "const": "decision_head.safetensors"
    },
    "adapter": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "lora",
            "frozen_head"
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "lora"
          }
        }
      },
      "then": {
        "required": [
          "rank",
          "alpha",
          "target_modules"
        ]
      }
    },
    "pooling": {
      "const": "last_token"
    },
    "hidden_size": {
      "type": "integer",
      "minimum": 1
    },
    "max_seq_len": {
      "type": "integer",
      "minimum": 1
    },
    "chat_template_kwargs": {
      "type": "object",
      "required": [
        "add_generation_prompt",
        "enable_thinking"
      ],
      "properties": {
        "add_generation_prompt": {
          "const": true
        },
        "enable_thinking": {
          "type": "boolean"
        }
      }
    },
    "truncation_side": {
      "const": "left"
    },
    "template_revision": {
      "type": "string",
      "minLength": 1
    },
    "preserve_thinking": {
      "type": "boolean"
    },
    "base_model": {
      "type": "string",
      "minLength": 1
    },
    "base_model_repo": {
      "type": "string",
      "minLength": 1
    },
    "base_model_revision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
