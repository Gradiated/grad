{
  "name": "@gradiated/grad-server",
  "version": "0.2.0-alpha.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && vitest run",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts",
    "metrics:check": "node --import tsx scripts/emit-metrics-doc.ts --check",
    "metrics:docs": "node --import tsx scripts/emit-metrics-doc.ts",
    "openapi:check": "node --import tsx scripts/emit-openapi.ts --check",
    "openapi:generate": "node --import tsx scripts/emit-openapi.ts",
    "start": "node dist/main.js",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1135.0",
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@prometheus-io/client": "0.16.1",
    "hono": "4.13.13",
    "pg": "8.23.0",
    "yaml": "2.9.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "20.17.50",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "4.1.11",
    "prettier": "3.6.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
